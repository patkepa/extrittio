{
  "name": "@extrittio/frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "npm --prefix ../../ui ci && npm --prefix ../../ui run build",
    "prebuild": "npm --prefix ../../ui run build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "generate-api": "cargo run --manifest-path ../../Cargo.toml -p extrittio-backend --bin openapi -- ../../api/openapi.json && openapi-typescript ../../api/openapi.json -o src/types/openapi.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-draw": "^1.0.13",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/react-window": "^1.8.8",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.3.2",
    "@blueprintjs/icons": "^6.2.0",
    "@extrittio/app-shell": "file:../../ui/packages/app-shell",
    "@extrittio/command-palette": "file:../../ui/packages/command-palette",
    "@extrittio/data-client": "file:../../ui/packages/data-client",
    "@extrittio/interactions": "file:../../ui/packages/interactions",
    "@extrittio/navigation": "file:../../ui/packages/navigation",
    "@extrittio/theme": "file:../../ui/packages/theme",
    "@extrittio/ui": "file:../../ui/packages/ui",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.16.1",
    "cmdk": "^1.1.1",
    "follow-redirects": "^1.16.0",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lodash-es": "^4.18.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.9.4",
    "react-window": "^2.2.7",
    "uplot": "^1.6.32",
    "zustand": "^5.0.8"
  }
}
