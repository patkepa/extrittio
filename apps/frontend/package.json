{
  "name": "@extrittio/frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-kantzen-sidebar.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "bundle": "vite build",
    "build": "npm run typecheck && npm run bundle",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "generate-openapi": "cargo run --manifest-path ../../Cargo.toml -p extrittio-backend --features openapi --bin openapi -- ../../api/openapi.json",
    "generate-api-types": "openapi-typescript ../../api/openapi.json -o src/types/openapi.ts",
    "generate-api": "npm run generate-openapi && npm run generate-api-types"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-draw": "^1.0.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "openapi-typescript": "^7.13.0",
    "oxc-transform-react": "^0.145.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@blueprintjs/icons": "^6.13.0",
    "@patkepa/kantzen-ui": "0.1.0",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.16.1",
    "cmdk": "^1.1.1",
    "follow-redirects": "^1.16.0",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lodash-es": "^4.18.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.4",
    "react-window": "^2.2.7",
    "uplot": "^1.6.32",
    "zustand": "^5.0.8"
  }
}
