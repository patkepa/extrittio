# Persistent single-node state. The package creates this directory.
EXTRITTIO_DATA_DIR=/var/lib/extrittio

# Address advertised in firmware download URLs. Change this to the Pi's stable
# LAN name or address before first start.
EXTRITTIO_PUBLIC_URL=http://extrittio-pi.local:8080

# Extrittio automatically starts Thread only when it can find both an RCP and
# an executable otbr-agent. If either is unavailable, it keeps serving
# Wi-Fi/cloud devices and periodically retries discovery. The .deb does not
# bundle OTBR; an existing system installation is discovered from PATH.
EXTRITTIO_THREAD_ENABLED=true

# Set this when otbr-agent is not in the system PATH.
# EXTRITTIO_OTBR_AGENT=/usr/sbin/otbr-agent

# Keep false to allow Wi-Fi/cloud-only operation when OTBR or the RCP is absent.
EXTRITTIO_THREAD_REQUIRED=false

# Set this before the first start. If omitted, the application uses its
# development default (admin), so change the resulting account immediately.
# EXTRITTIO_BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password
