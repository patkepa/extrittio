EXTRITTIO_IMAGE=ghcr.io/patkepa/extrittio
EXTRITTIO_VERSION=0.1.0
EXTRITTIO_DOMAIN=extrittio.example.com
EXTRITTIO_PUBLIC_URL=https://extrittio.example.com
CORS_ORIGIN=https://extrittio.example.com

POSTGRES_PASSWORD=replace-with-random-secret
JWT_SECRET=replace-with-random-secret
EXTRITTIO_KEY_ENCRYPTION_SECRET=replace-with-random-secret
EXTRITTIO_HEALTH_TOKEN=replace-with-random-secret
EXTRITTIO_BOOTSTRAP_ADMIN_USERNAME=admin
EXTRITTIO_BOOTSTRAP_ADMIN_PASSWORD=

HTTP_PORT=80
ZENOH_PORT=7447
ZENOH_TLS_ENABLED=true
ZENOH_LISTEN_HOST=0.0.0.0
ZENOH_MAX_PAYLOAD_KB=256
EXTRITTIO_LOG_FORMAT=json

# Durable firmware storage. The local backend uses the named Compose volume.
# For S3-compatible storage, set backend=s3 and provide the bucket/credentials.
FIRMWARE_STORAGE_BACKEND=local
FIRMWARE_STORAGE_PATH=/app/data/firmware
FIRMWARE_S3_BUCKET=
FIRMWARE_S3_REGION=us-east-1
FIRMWARE_S3_ENDPOINT=
FIRMWARE_S3_ALLOW_HTTP=false
FIRMWARE_S3_VIRTUAL_HOSTED_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional OTLP/HTTP collector endpoint, for example http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
