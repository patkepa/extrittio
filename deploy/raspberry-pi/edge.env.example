# Persistent Extrittio Edge state. Never put this directory inside a release.
EXTRITTIO_DATA_DIR=/var/lib/extrittio

# A stable LAN name or address that browsers and Wi-Fi devices can reach.
# It is also used in generated firmware download URLs.
EXTRITTIO_PUBLIC_URL=http://extrittio-pi.local:8080

# Fail the service rather than silently falling back to Wi-Fi-only mode.
EXTRITTIO_THREAD_REQUIRED=true

# Use the stable path shown by: ls -l /dev/serial/by-id/
EXTRITTIO_THREAD_RCP=/dev/serial/by-id/REPLACE_WITH_YOUR_NORDIC_RCP

# Normally eth0 on a wired Pi. Use wlan0 only when that is the infrastructure
# connection that must route traffic between Thread and the LAN.
EXTRITTIO_THREAD_INFRA_INTERFACE=eth0
