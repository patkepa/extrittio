@@ -138,5 +139,25 @@ RestWebServer::RestWebServer(Host::RcpHost &aHost)
     : mHost(aHost)
 {
+    const char *token = std::getenv("EXTRITTIO_OTBR_REST_TOKEN");
+    const std::string expectedAuthorization =
+        token == nullptr || token[0] == '\0' ? std::string() : std::string("Bearer ") + token;
+    unsetenv("EXTRITTIO_OTBR_REST_TOKEN");
+
+    // The REST API includes dataset and destructive node routes. Authenticate
+    // every request before routing so a different local user cannot retrieve
+    // credentials or mutate OTBR merely because the listener is on loopback.
+    mServer.set_pre_routing_handler(
+        [expectedAuthorization](const Request &aRequest, Response &aResponse) {
+            if (expectedAuthorization.empty() ||
+                aRequest.get_header_value("Authorization") != expectedAuthorization)
+            {
+                aResponse.status = static_cast<int>(StatusCode::Unauthorized_401);
+                aResponse.set_content("{\"error\":\"unauthorized\"}", OT_REST_CONTENT_TYPE_JSON);
+                return Server::HandlerResponse::Handled;
+            }
+            return Server::HandlerResponse::Unhandled;
+        });
+
     mServer.Get(OT_REST_RESOURCE_PATH_NODE, MakeHandler(&RestWebServer::NodeInfo));
     mServer.Delete(OT_REST_RESOURCE_PATH_NODE, MakeHandler(&RestWebServer::NodeInfo));
     mServer.Get(OT_REST_RESOURCE_PATH_NODE_BAID, MakeHandler(&RestWebServer::BaId));
