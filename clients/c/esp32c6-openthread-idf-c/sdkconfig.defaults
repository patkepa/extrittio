# The ESP32-C6 has a native IEEE 802.15.4 radio, used by OpenThread.
CONFIG_PARTITION_TABLE_TWO_OTA=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_FREERTOS_HZ=1000

# OpenThread and its ESP-NETIF/lwIP IPv6 bridge.
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_BORDER_ROUTER=n
CONFIG_OPENTHREAD_DNS_CLIENT=y
# This telemetry device must join the hobby RCP's mesh; unlike an FTD, an MTD
# cannot form an isolated leader partition when it loses radio contact.
CONFIG_OPENTHREAD_MTD=y
# CONFIG_OPENTHREAD_FTD is not set
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_HOOK_IP6_SELECT_SRC_ADDR_CUSTOM=y

# Development-only public OpenThread test dataset. It must match the dataset
# imported into the Extrittio hobby backend. Do not use this key outside a
# controlled local test mesh.
CONFIG_EXTRITTIO_THREAD_ACTIVE_DATASET_TLVS="0e080000000000010000000300001935060004001fffe00208ef1398c2fd504b670708fd35344133d1d73e0510fda7c771a27202e232ecd04cf934f476030f4f70656e5468726561642d633634650102c64e04105e9b9b360f80b88be2603fb0135c8d650c0402a0f7f8"
