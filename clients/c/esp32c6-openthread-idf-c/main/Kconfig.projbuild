menu "Extrittio Thread Device"

config EXTRITTIO_DEVICE_ID
    string "Device ID"
    default "esp32c6-thread-001"
    help
        Unique identifier registered in Extrittio.

config EXTRITTIO_THREAD_ZENOH_SERVICE_NAME
    string "Thread DNS-SD Zenoh service"
    default "_extrittio-zenoh._tcp.default.service.arpa."
    help
        Fully-qualified Thread DNS-SD service advertised by Extrittio Edge
        server. The default matches EXTRITTIO_THREAD_ZENOH_SERVICE_NAME on the
        server and OTBR's default service-discovery domain.

config EXTRITTIO_THREAD_ZENOH_INSTANCE_NAME
    string "Thread DNS-SD Zenoh instance"
    default "extrittio-backend"
    help
        Stable DNS-SD instance advertised by the Extrittio Edge server. The
        default matches EXTRITTIO_THREAD_ZENOH_SERVICE_INSTANCE on the server.

config EXTRITTIO_THREAD_ZENOH_LOCATOR
    string "Thread Zenoh locator fallback"
    default "tcp/[fd35:3441:33d1:d73e:9ead:6dbd:a06b:da7]:7447"
    help
        Direct Zenoh locator used after three failed Thread DNS-SD discovery
        attempts. The development default targets the bundled development
        Thread network. For a custom network, replace it with the address from
        the Extrittio Thread DNS-SD advertisement log. Leave it empty to
        require DNS-SD discovery.

config EXTRITTIO_THREAD_ACTIVE_DATASET_TLVS
    string "Thread Active Operational Dataset (hex TLVs)"
    default ""
    help
        Hex-encoded Active Operational Dataset exported from Extrittio's Thread
        Network settings. The dataset contains the Thread network key; do not
        commit it to source control or share a generated sdkconfig file.

config EXTRITTIO_THREAD_CLEAR_PERSISTENT_STATE_ON_BOOT
    bool "Clear persisted OpenThread state before joining"
    default y
    help
        Rejoin the configured Thread network on every boot instead of restoring
        the prior child state. This prevents stale link-security counters after
        the local OTBR or device firmware is restarted. Disable only when the
        device must preserve a network joined through commissioning.

config EXTRITTIO_THREAD_TX_POWER_DBM
    int "Thread radio transmit power (dBm)"
    range -24 20
    default 20
    help
        Transmit power used by the ESP32-C6 802.15.4 radio. The OpenThread
        upstream default is 0 dBm, which is unnecessarily weak for a
        standalone Thread node. Keep this at the board's supported maximum
        unless local radio regulations or power constraints require less.

config EXTRITTIO_TELEMETRY_INTERVAL_S
    int "Telemetry interval (seconds)"
    range 1 3600
    default 30

config EXTRITTIO_HEARTBEAT_INTERVAL_S
    int "Heartbeat interval (seconds)"
    range 5 86400
    default 60

config EXTRITTIO_FIRMWARE_VERSION
    string "Firmware version"
    default "v1.0.0-esp32c6-thread-c"

endmenu
