# Increase main task stack size (Zenoh needs more stack)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Use one large factory app slot. Zenoh makes this client too large for
# ESP-IDF's default 1 MB app slots on 4 MB ESP32-C6 modules.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions_esp32c6.csv"

# ESP32-C6 dev modules are commonly 4 MB or larger. The two-OTA partition
# table does not fit in ESP-IDF's default 2 MB flash setting.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Enable pthread support (required by Zenoh runtime)
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
