# ========================
# Database
# ========================
DATABASE_URL=postgres://extrittio:extrittio@localhost/extrittio
DB_POOL_SIZE=16
# Enable Raspberry Pi / SD-card friendly defaults for values that are not
# explicitly set below.
RPI_MODE=false
# Optional host port used by Docker PostgreSQL.
# Leave unset to use 5432.
# POSTGRES_PORT=5432

# ========================
# Server
# ========================
PORT=8080
CORS_ORIGIN=http://localhost:5173
# Optional token required by /ready when set. Production compose requires it.
EXTRITTIO_HEALTH_TOKEN=

# Production Docker image tag used by deploy/docker/docker-compose.production.yml.
# Set this to an explicit release version before running production Compose.
EXTRITTIO_VERSION=0.1.0

# ========================
# Devices
# ========================
# Seconds without a heartbeat before a device is marked offline
OFFLINE_TIMEOUT_SECS=300
# Seconds before a pending command is marked as timed out
COMMAND_TIMEOUT_SECS=30

# ========================
# Firmware
# ========================
MAX_FIRMWARE_SIZE_MB=100
# New uploads use atomic object storage rather than PostgreSQL BYTEA rows.
# `local` is suitable for development; production can use `s3` with AWS_*
# credentials and the optional S3-compatible endpoint settings below.
FIRMWARE_STORAGE_BACKEND=local
FIRMWARE_STORAGE_PATH=./data/firmware
# FIRMWARE_S3_BUCKET=extrittio-firmware
# FIRMWARE_S3_REGION=us-east-1
# FIRMWARE_S3_ENDPOINT=https://s3.example.com
# FIRMWARE_S3_ALLOW_HTTP=false
# FIRMWARE_S3_VIRTUAL_HOSTED_STYLE=false

# ========================
# Alerts
# ========================
# Days to retain resolved alerts before deletion
ALERT_RETENTION_DAYS=30
# Days to retain raw contract events and typed samples (cutoff hour is preserved)
TELEMETRY_RETENTION_DAYS=30
# Days to retain hourly metric rollups and duplicate-delivery receipts; must be >= raw retention
METRIC_ROLLUP_RETENTION_DAYS=365
# Days to retain device log rows before deletion
LOG_RETENTION_DAYS=30

# ========================
# Internal metrics
# ========================
# Seconds between host metric samples
SYSTEM_METRICS_INTERVAL_SECS=10
# Rule snapshot polling: 1–60 seconds, default 5 for every deployment profile.
RULE_SNAPSHOT_REFRESH_INTERVAL_SECS=5
# Seconds between application metric flushes
APP_METRICS_FLUSH_INTERVAL_SECS=10
# Hours to retain internal server/application metrics
METRICS_RETENTION_HOURS=24

# ========================
# Zenoh TLS (optional)
# ========================
ZENOH_TLS_ENABLED=false
ZENOH_TLS_PORT=7447
EXTRITTIO_CERTS_DIR=./certs
