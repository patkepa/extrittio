# ========================
# Database
# ========================
DATABASE_URL=postgres://extrittio:extrittio@localhost/extrittio
DB_POOL_SIZE=16

# ========================
# Server
# ========================
PORT=8080
CORS_ORIGIN=http://localhost:5173

# ========================
# Devices
# ========================
# Seconds without a heartbeat before a device is marked offline
OFFLINE_TIMEOUT_SECS=300
# Seconds before a pending command is marked as timed out
COMMAND_TIMEOUT_SECS=30

# ========================
# Firmware
# ========================
MAX_FIRMWARE_SIZE_MB=100

# ========================
# Alerts
# ========================
# Days to retain resolved alerts before deletion
ALERT_RETENTION_DAYS=30

# ========================
# Zenoh TLS (optional)
# ========================
ZENOH_TLS_ENABLED=false
ZENOH_TLS_PORT=7447
EXTRITTIO_CERTS_DIR=./certs
