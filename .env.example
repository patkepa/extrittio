# ========================
# Database
# ========================
DATABASE_URL=postgres://extrittio:extrittio@localhost/extrittio
DB_POOL_SIZE=16
# Enable Raspberry Pi / SD-card friendly defaults for values that are not
# explicitly set below.
RPI_MODE=false
# Optional: host port used by Docker PostgreSQL in ./start-dev.sh.
# Leave unset to use 5432, or automatically fall back to 5433-5439 when busy.
# POSTGRES_PORT=5432

# ========================
# Server
# ========================
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Production Docker image tag used by docker/docker-compose.prod.yml.
# Set this to an explicit release version before running production Compose.
EXTRITTIO_VERSION=0.1.0

# ========================
# Devices
# ========================
# Seconds without a heartbeat before a device is marked offline
OFFLINE_TIMEOUT_SECS=300
# Seconds before a pending command is marked as timed out
COMMAND_TIMEOUT_SECS=30

# ========================
# Firmware
# ========================
MAX_FIRMWARE_SIZE_MB=100

# ========================
# Alerts
# ========================
# Days to retain resolved alerts before deletion
ALERT_RETENTION_DAYS=30
# Days to retain raw telemetry rows before deletion
TELEMETRY_RETENTION_DAYS=30
# Days to retain device log rows before deletion
LOG_RETENTION_DAYS=30

# ========================
# Internal metrics
# ========================
# Seconds between host metric samples
SYSTEM_METRICS_INTERVAL_SECS=10
# Seconds between application metric flushes
APP_METRICS_FLUSH_INTERVAL_SECS=10
# Hours to retain internal server/application metrics
METRICS_RETENTION_HOURS=24

# ========================
# Zenoh TLS (optional)
# ========================
ZENOH_TLS_ENABLED=false
ZENOH_TLS_PORT=7447
EXTRITTIO_CERTS_DIR=./certs
