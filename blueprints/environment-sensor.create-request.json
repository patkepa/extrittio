{
  "apiVersion": "extrittio.io/v1alpha1",
  "kind": "DeviceBlueprint",
  "metadata": {
    "key": "environment-sensor",
    "name": "Environment sensor",
    "description": "A generic battery-powered sensor that reports temperature and relative humidity.",
    "icon": "temperature",
    "color": "#4C90F0",
    "labels": { "category": "environment" }
  },
  "spec": {
    "runtime": {
      "minimumContractApi": 1,
      "heartbeat": { "interval": "30s", "offlineAfter": "95s" },
      "limits": { "maxMessageBytes": 4096, "maxMessagesPerMinute": 120, "maxMetricCardinality": 16 }
    },
    "transports": [
      {
        "key": "primary",
        "binding": "primary_zenoh",
        "protocol": "zenoh",
        "qos": { "delivery": "at_least_once", "ordering": "per_device_stream" }
      }
    ],
    "routes": [
      {
        "key": "readings",
        "transport": "primary",
        "direction": "device_to_cloud",
        "address": "extrittio/devices/{device.id}/events/readings",
        "messageSchema": "environment-reading@1",
        "encoding": "json"
      }
    ],
    "schemas": [
      {
        "key": "environment-reading@1",
        "format": "json_schema",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["temperature", "humidity", "batteryPercent"],
          "properties": {
            "temperature": { "type": "number", "minimum": -80, "maximum": 120 },
            "humidity": { "type": "number", "minimum": 0, "maximum": 100 },
            "batteryPercent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    ],
    "streams": [
      {
        "key": "environment",
        "route": "readings",
        "timestamp": "envelope.occurred_at",
        "fields": [
          {
            "path": "/temperature", "type": "float64", "label": "Temperature", "unit": "°C",
            "semantic": "temperature", "index": true, "aggregates": ["min", "max", "avg"],
            "presentation": { "color": "#4C90F0", "chart": "line", "precision": 1 }
          },
          {
            "path": "/humidity", "type": "float64", "label": "Relative humidity", "unit": "%",
            "semantic": "relative_humidity", "index": true, "aggregates": ["min", "max", "avg"],
            "presentation": { "color": "#36CFC9", "chart": "line", "precision": 1 }
          },
          {
            "path": "/batteryPercent", "type": "float64", "label": "Battery", "unit": "%",
            "semantic": "battery_level", "index": true, "aggregates": ["min", "avg", "last"],
            "presentation": { "chart": "line", "precision": 0 }
          }
        ]
      }
    ],
    "commands": [],
    "configuration": {
      "schema": {
        "type": "object", "additionalProperties": false, "required": ["sampleIntervalSeconds"],
        "properties": { "sampleIntervalSeconds": { "type": "integer", "minimum": 5, "maximum": 3600, "default": 60 } }
      },
      "defaults": { "sampleIntervalSeconds": 60 },
      "apply": { "mode": "desired_reported", "acknowledgementTimeout": "60s", "atomic": true }
    },
    "health": {
      "signals": [
        { "key": "battery-low", "source": "metric", "path": "environment./batteryPercent", "operator": "lt", "value": 15, "severity": "warning" }
      ]
    },
    "firmware": { "strategy": "binary_replacement", "compatibility": { "contractApi": 1 } },
    "relationships": [],
    "presentation": {
      "summary": [
        { "metric": "environment./temperature" },
        { "metric": "environment./humidity" },
        { "metric": "environment./batteryPercent" }
      ],
      "tabs": ["overview", "telemetry", "configuration", "firmware"]
    }
  }
}
