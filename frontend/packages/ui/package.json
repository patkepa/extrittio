{
  "name": "@extrittio/ui",
  "version": "0.1.0",
  "description": "Reusable Extrittio UI primitives for toolbars, search, filters, status, and empty states.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/ui.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/*.css dist/"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patkepa/extrittio.git",
    "directory": "frontend/packages/ui"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^6.3.2",
    "@blueprintjs/icons": "^6.2.0",
    "react": "^18.3.1"
  }
}
