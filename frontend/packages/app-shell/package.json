{
  "name": "@extrittio/app-shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/*.css dist/ && cp styles.css dist/styles.css"
  },
  "dependencies": {
    "@extrittio/interactions": "0.0.0",
    "@extrittio/navigation": "0.0.0",
    "@extrittio/ui": "0.0.0"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^6.3.2",
    "@blueprintjs/icons": "^6.2.0",
    "react": "^18.3.1",
    "react-router-dom": "^7.9.4"
  }
}
