{
  "name": "@extrittio/app-shell",
  "version": "0.1.0",
  "description": "Reusable Extrittio application shell, sidebar, navbar, and error boundary.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/*.css dist/ && cp styles.css dist/styles.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patkepa/extrittio.git",
    "directory": "frontend/packages/app-shell"
  },
  "dependencies": {
    "@extrittio/interactions": "^0.1.0",
    "@extrittio/navigation": "^0.1.0",
    "@extrittio/ui": "^0.1.0"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^6.3.2",
    "@blueprintjs/icons": "^6.2.0",
    "react": "^18.3.1",
    "react-router-dom": "^7.9.4"
  }
}
