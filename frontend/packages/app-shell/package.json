{
  "name": "@extrittio/app-shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/app-shell/index.d.ts",
      "import": "./dist/app-shell/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp ../../src/lib/app-shell/*.css dist/app-shell/ && cp ../../src/lib/ui/*.css dist/ui/ && cp styles.css dist/styles.css"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^6.3.2",
    "@blueprintjs/icons": "^6.2.0",
    "react": "^18.3.1",
    "react-router-dom": "^7.9.4"
  }
}
