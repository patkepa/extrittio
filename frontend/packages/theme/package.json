{
  "name": "@patkepa/theme",
  "version": "0.1.0",
  "description": "Extrittio dark theme provider and CSS custom property theme.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/theme.css dist/theme.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patkepa/extrittio.git",
    "directory": "frontend/packages/theme"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
