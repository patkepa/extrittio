{
  "name": "@extrittio/command-palette",
  "version": "0.1.0",
  "description": "Reusable Extrittio command palette shell built around cmdk.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/command-palette.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/command-palette.css dist/command-palette.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patkepa/extrittio.git",
    "directory": "frontend/packages/command-palette"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^6.3.2",
    "cmdk": "^1.1.1",
    "react": "^18.3.1"
  }
}
