{
  "name": "frontend-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/navigation",
    "packages/interactions",
    "packages/ui",
    "packages/theme",
    "packages/data-client",
    "packages/command-palette",
    "packages/app-shell"
  ],
  "scripts": {
    "dev": "npm run build:packages && vite",
    "build": "npm run build:packages && tsc && vite build",
    "build:packages": "npm run build --workspaces --if-present",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "generate-api": "cd .. && cargo run --bin openapi > api/openapi.json && cd frontend && openapi-typescript ../api/openapi.json -o src/types/openapi.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-draw": "^1.0.13",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/react-window": "^1.8.8",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.3.2",
    "@blueprintjs/icons": "^6.2.0",
    "@extrittio/app-shell": "0.0.0",
    "@extrittio/command-palette": "0.0.0",
    "@extrittio/data-client": "0.0.0",
    "@extrittio/interactions": "0.0.0",
    "@extrittio/navigation": "0.0.0",
    "@extrittio/theme": "0.0.0",
    "@extrittio/ui": "0.0.0",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.12.2",
    "cmdk": "^1.1.1",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.9.4",
    "react-window": "^2.2.7",
    "uplot": "^1.6.32",
    "zustand": "^5.0.8"
  }
}
