{
  "name": "@extrittio/theme",
  "version": "0.1.0",
  "description": "Extrittio dark theme provider and CSS custom property theme.",
  "license": "MIT",
  "homepage": "https://github.com/extrittio/ui/tree/main/packages/theme#readme",
  "bugs": {
    "url": "https://github.com/extrittio/ui/issues"
  },
  "keywords": [
    "extrittio",
    "react",
    "theme",
    "css",
    "dark-theme"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/theme.css dist/theme.css"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extrittio/ui.git",
    "directory": "packages/theme"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
