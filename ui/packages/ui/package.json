{
  "name": "@extrittio/ui",
  "version": "0.1.0",
  "description": "Reusable Extrittio workspace controls and public site content primitives.",
  "license": "MIT",
  "homepage": "https://github.com/extrittio/ui/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/extrittio/ui/issues"
  },
  "keywords": [
    "extrittio",
    "react",
    "ui",
    "components",
    "workspace",
    "site"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/ui.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/*.css dist/"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extrittio/ui.git",
    "directory": "packages/ui"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^6.3.2",
    "@blueprintjs/icons": "^6.2.0",
    "react": "^18.3.1"
  }
}
