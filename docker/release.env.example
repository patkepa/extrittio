EXTRITTIO_IMAGE=ghcr.io/extrittio/extrittio
EXTRITTIO_VERSION=latest
EXTRITTIO_DOMAIN=extrittio.example.com
EXTRITTIO_PUBLIC_URL=https://extrittio.example.com
CORS_ORIGIN=https://extrittio.example.com

POSTGRES_PASSWORD=replace-with-random-secret
JWT_SECRET=replace-with-random-secret
EXTRITTIO_KEY_ENCRYPTION_SECRET=replace-with-random-secret
EXTRITTIO_HEALTH_TOKEN=replace-with-random-secret
EXTRITTIO_BOOTSTRAP_ADMIN_USERNAME=admin
EXTRITTIO_BOOTSTRAP_ADMIN_PASSWORD=

HTTP_PORT=80
ZENOH_TLS_ENABLED=false
ZENOH_LISTEN_HOST=127.0.0.1
ZENOH_MAX_PAYLOAD_KB=256
