menu "Extrittio Network Analyzer"

config EXTRITTIO_DEVICE_ID
    string "Device ID"
    default "esp32-network-analyzer-001"
    help
        Unique identifier for this analyzer device.

config EXTRITTIO_WIFI_SSID
    string "WiFi SSID"
    default ""
    help
        WiFi network name.

config EXTRITTIO_WIFI_PASSWORD
    string "WiFi Password"
    default ""
    help
        WiFi network password.

config EXTRITTIO_ZENOH_CONNECT
    string "Zenoh endpoint"
    default "tcp/192.0.2.100:7447"
    help
        Zenoh router endpoint to connect to.

config EXTRITTIO_SCAN_INTERVAL_S
    int "Network scan interval (seconds)"
    default 60
    range 10 3600
    help
        Seconds between local network scans.

config EXTRITTIO_HEARTBEAT_INTERVAL_S
    int "Heartbeat interval (seconds)"
    default 60
    range 10 3600
    help
        Seconds between heartbeat publishes.

config EXTRITTIO_ANALYZER_MAX_SCAN_TARGETS
    int "Maximum IPv4 scan targets"
    default 254
    range 1 1024
    help
        Maximum number of local subnet IPv4 addresses to ping per scan.

config EXTRITTIO_ANALYZER_MAX_HOSTS
    int "Maximum reported hosts"
    default 48
    range 1 128
    help
        Maximum reachable hosts included in each telemetry snapshot.

config EXTRITTIO_ANALYZER_PING_TIMEOUT_MS
    int "Probe timeout per host (ms)"
    default 120
    range 20 1000
    help
        Timeout for each one-shot ARP or metadata probe.

config EXTRITTIO_ANALYZER_SNAPSHOT_BYTES
    int "Snapshot JSON buffer bytes"
    default 6144
    range 1024 12000
    help
        Maximum JSON snapshot size stored in telemetry metadata.

config EXTRITTIO_FIRMWARE_VERSION
    string "Firmware version"
    default "v1.0.0-network-analyzer-c"
    help
        Reported firmware version string.

endmenu
